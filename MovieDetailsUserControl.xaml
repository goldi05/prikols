<UserControl x:Class="View.MovieDetailsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="Детали и оценка фильма" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding SelectedMovie.Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding SelectedMovie.ReleaseYear, StringFormat='Год: {0}'}" Foreground="Gray"/>
            <TextBlock Text="{Binding SelectedMovie.Genre.Name, StringFormat='Жанр: {0}'}" Foreground="Gray"/>
            <TextBlock Text="{Binding SelectedMovie.Director.FullName, StringFormat='Режиссер: {0}'}" Foreground="Gray" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedMovie.Description}" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <Separator Margin="0,0,0,15"/>

            <TextBlock Text="Ваша оценка и отзыв:" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Оценка (1-10): " VerticalAlignment="Center"/>
                <TextBox Text="{Binding EditRating, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Ваш отзыв:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding EditReview, UpdateSourceTrigger=PropertyChanged}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,10"/>

            <Button Content="Сохранить отзыв"
                    Command="{Binding SaveReviewCommand}"
                    Height="30"
                    Width="140"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
